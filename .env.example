# Port for the local Express static server (defaults to 3000)
PORT=3000

# Public Stripe Payment Links created in your Stripe Dashboard
# Configure each Payment Link's post-payment redirect URL in Stripe:
# - Single Session: https://your-domain/success_page.html?plan=single
# - Monthly Plan:   https://your-domain/success_page.html?plan=monthly
STRIPE_SINGLE_SESSION_URL=
STRIPE_MONTHLY_PLAN_URL=

# Direct SMTP Email Delivery (replaces Formspree and supports file attachments)
# Example for iCloud Mail: SMTP_HOST=smtp.mail.me.com, SMTP_PORT=587, SMTP_USER=<primary Apple Account email>, SMTP_PASS=<Apple App-Specific Password>
# Example for Gmail:       SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=<Google App Password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=novascholarsacademy@icloud.com
